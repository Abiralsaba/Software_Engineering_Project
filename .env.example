# NationX local configuration. Copy to .env and keep the real file out of Git.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=central_govt_db
JWT_SECRET=replace-with-a-long-random-local-secret

# Medicine Identifier — backend only. Never expose this key to the React client.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_ENABLED=true
GEMINI_TIMEOUT_MS=30000
MEDICINE_SCAN_RATE_LIMIT=10

# Voice assistant: external local whisper.cpp installation, never inside public/.
VOICE_ASSISTANT_ENABLED=true
WHISPER_BASE_URL=http://127.0.0.1:8081
WHISPER_SERVER_BIN=
WHISPER_MODEL_PATH=
# Bengali: absolute path to ggml-bengali-medium-q4_0.bin (see scripts/assistant/whisper.js).
# Bengali playback uses the locally installed macOS Piya voice; no cloud TTS.
# Optional overrides: GEMINI_ASSISTANT_MODEL, FFMPEG_BIN
