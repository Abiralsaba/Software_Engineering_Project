{
  "name": "central-govt",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/app.js",
    "db:install:test": "node scripts/database/install.js --target central_govt_db_test",
    "db:reset:test": "node scripts/database/install.js --target central_govt_db_test --reset",
    "db:install:dev": "node scripts/database/install.js --target central_govt_db",
    "test": "node --test --test-concurrency=1 test/regression/*.test.js",
    "test:baseline": "node --test --test-concurrency=1 test/regression/database-baseline.test.js",
    "client:install": "npm install --prefix client",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "client:test": "npm test --prefix client",
    "test:browser": "playwright test",
    "start:react": "FRONTEND_MODE=react API_RATE_LIMIT_MAX=2000 node src/app.js",
    "medicine:test": "python3 -m unittest discover -s test/medicine -p 'test_*.py' -v",
    "medicine:build": "python3 -m scripts.medicine.pipeline --market-csv dataset/medicine.csv --registered-xlsx dataset/bd_registered_drag_info.xlsx --output-dir generated/medicine",
    "medicine:import:test": "node scripts/medicine/import.js --mode import --target central_govt_db_test --output-dir generated/medicine",
    "medicine:verify:test": "node scripts/medicine/import.js --mode verify --target central_govt_db_test --output-dir generated/medicine",
    "medicine:rollback:test": "node scripts/medicine/rollback.js --target central_govt_db_test --output-dir generated/medicine",
    "medicine:identifier:migrate:test": "node scripts/medicine/identifier-migrate.js --target central_govt_db_test",
    "medicine:identifier:migrate:dev": "node scripts/medicine/identifier-migrate.js --target central_govt_db --allow-development",
    "medicine:identifier:test": "node --test --test-concurrency=1 test/medicine-identifier/*.test.js test/regression/medicine-identifier-api.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.20.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.16.0",
    "nodemailer": "^7.0.11",
    "sharp": "^0.35.4",
    "sslcommerz-lts": "^1.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
